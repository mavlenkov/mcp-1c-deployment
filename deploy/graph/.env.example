# Graph beta-контур — заполнить и держать локально (НЕ коммитить).
# Значения — из deploy/.env / config.env дистрибутива (beta-ключи!).

COMPOSE_PROJECT_NAME=graph_metadata_beta
IMAGE_TAG=light-beta

# Ключ BETA-канала: LICENSE_KEY_GRAPH_BETA из config.env дистрибутива
LICENSE_KEY=

# Данные 1С (каталог базы монтируется НА ЗАПИСЬ — business_info.html)
METADATA_FILES_HOST_PATH=/home/l7777/mcp/LISfiles
EXTENSIONS_HOST_PATH=/home/l7777/mcp/extensions
PROJECT_NAME=LISmcp

# Extension catalog (слои расширений одного проекта)
EXTENSION_CATALOG_ENABLED=true
EXTENSION_CATALOG_SYNC=true
EXTENSION_ORDER_MANIFEST=

# Чистая Neo4j greenfield — scoped contract включён
GRAPH_SCOPE_ENFORCED=true
# ОКНО МИГРАЦИИ: boot-пайплайн индексации НЕ промоутит генерации; без этого окна
# проект не регистрируется в tool-scope и scoped-инструменты отвечают
# project_not_accessible. Держать true (один проект — ослабление scope некритично).
GRAPH_SCOPE_MIGRATION_WINDOW=true
# Manifest refresh (refresh_graph_project обновляет на месте, сохраняя
# business-описания/эмбеддинги). Не выключать.
SOURCE_UNIT_MANIFEST_ENABLED=true

# Хранилища beta-контура (отдельно от всего stable)
PATH_BASES=/opt/mcp-data
NEO4J_DATA_PATH=/opt/mcp-data/graph_neo4j_beta
GRAPH_STATE_PATH=/opt/mcp-data/graph_mcp_state_beta

# Порты beta-контура
NEO4J_HTTP_PORT=7574
NEO4J_BOLT_PORT=7787
MCP_HOST_PORT=8106
NEO4J_CONTAINER_NAME=neo4j_beta
MCP_CONTAINER_NAME=1c_graph_metadata_beta

# Пароль локальной Neo4j (задать явно! в compose дефолт password123)
NEO4J_PASSWORD=

# Semantic/business search (GRAPH_ONLY=false): chat через OPENAI_* (имена
# вендора внутри graph) = CHAT_* из config.env; embeddings — EMBEDDING_*
GRAPH_ONLY=false
OPENAI_API_BASE=
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen3-235b-a22b
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
CALCULATE_BUSINESS_INFO=true
ENABLE_BUSINESS_SEARCH=true
ENABLE_ROUTINE_EMBEDDINGS=true
