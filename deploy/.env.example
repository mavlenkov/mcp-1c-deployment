# ============================================================================
# deploy/.env.example — BETA-контур MCP 1С на alcor (greenfield 2026-09)
# Скопировать в deploy/.env и заполнить. Заполненный .env НЕ коммитить.
# Ключи beta-канала: из MCP_Distr/config.env (LICENSE_KEY_*_BETA) или ЛК
# https://vibecoding1c.ru/. Stable-ключи к beta-образам НЕ подходят.
# ============================================================================

# --- Лицензионные ключи BETA-канала (НЕ stable!) ---
LICENSE_KEY_HELP_BETA=
LICENSE_KEY_GRAPH_BETA=
LICENSE_KEY_CODEMETADATA_BETA=
LICENSE_KEY_SSL_BETA=
LICENSE_KEY_TEMPLATES_BETA=
LICENSE_KEY_SYNTAX_BETA=
LICENSE_KEY_CODECHECKER_BETA=

# --- Embedding API (help, codemetadata, ssl, templates, graph) ---
# Base URL — полностью, с /v1. Напр. https://openrouter.ai/api/v1 или https://routerai.ru/api/v1
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# --- Пути на alcor ---
PATH_BASES=/opt/mcp-data
PATH_CODE=/home/l7777/mcp/LISfiles
PATH_EXTENSIONS=/home/l7777/mcp/extensions
PATH_1C_BIN=

# --- БСП ---
SSL_VERSION=3.1.11

# --- 1CCodeChecker: внешний env-файл с ONEC_AI_TOKEN (вне репозитория!) ---
ONEC_ENV_FILE=/home/l7777/.mcp-secrets/1c-code-checker.env
